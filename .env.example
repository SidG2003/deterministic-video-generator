# Copy this file to `.env` and fill in the credentials for the provider(s) you
# use. `.env` is gitignored, so your real keys never get committed. The values
# here are auto-loaded at runtime by dvg.llm (via python-dotenv).
#
# The provider is chosen from the --model id, NOT from a flag:
#   claude-*                -> Anthropic         (needs ANTHROPIC_API_KEY)
#   gpt-* / o1* / o3* / o4* -> Azure OpenAI (numbered blocks below) or public OpenAI
# You only need to fill in the section for the provider(s) you actually call.

# --- Anthropic (claude-* models) --------------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI public API (gpt-*/o* models) ------------------------------------
# Used for gpt-*/o* models only if no Azure block below matches the --model.
OPENAI_API_KEY=

# --- Azure OpenAI deployments (gpt-*/o* models) -----------------------------
# Configure one NUMBERED block per deployment. Each block may point at its own
# Azure resource (its own endpoint + key), so different models can live on
# different resources. Pass a block's DEPLOYMENT value as --model, e.g.:
#     python -m dvg.generate "..." --model my-gpt-deployment-name
#
# Shared API version; a per-block AZURE_OPENAI_<N>_API_VERSION overrides it.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# 1) first deployment
AZURE_OPENAI_1_ENDPOINT=https://<resource-1>.openai.azure.com
AZURE_OPENAI_1_DEPLOYMENT=<deployment-name-1>
AZURE_OPENAI_1_API_KEY=

# 2) second deployment (add more blocks as needed: _3_, _4_, ...)
AZURE_OPENAI_2_ENDPOINT=https://<resource-2>.openai.azure.com
AZURE_OPENAI_2_DEPLOYMENT=<deployment-name-2>
AZURE_OPENAI_2_API_KEY=

# (Legacy single-block form is still honored as a fallback for any gpt/o model
#  that matches no numbered block:
#     AZURE_OPENAI_ENDPOINT=...   AZURE_OPENAI_API_KEY=...  )

# --- Adobe Firefly 3p audio (optional; TTS for `--narrate --tts firefly`) ----
# ElevenLabs via Firefly. The bearer is an Adobe IMS access token (~24h-lived) —
# refresh it when calls start returning 401. Copy from the firefly.adobe.com
# request (Network tab). FIREFLY_VOICE_ID is optional (a default voice is used).
#FIREFLY_AUDIO_ENDPOINT=https://firefly-3p.ff.adobe.io/v2/3p-audios/generate-speech-async
#FIREFLY_API_KEY=clio-playground-web
#FIREFLY_BEARER=eyJ...   # short-lived; do not commit (real token lives in .env)
#FIREFLY_VOICE_ID=onwK4e9ZLuTAKqWW03F9
