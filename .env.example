# Copy this file to `.env` and fill in the credentials for the provider(s) you
# use. `.env` is gitignored, so your real keys never get committed. The values
# here are auto-loaded at runtime by dvg.llm (via python-dotenv).
#
# The provider is chosen from the --model id, NOT from a flag:
#   claude-*            -> Anthropic       (needs ANTHROPIC_API_KEY)
#   gpt-* / o1* / o3* / o4* -> OpenAI or Azure OpenAI
# For the OpenAI family, the Azure path is used whenever AZURE_OPENAI_ENDPOINT
# is set; otherwise the public OpenAI API is used. You only need to fill in the
# section for the provider you actually call.

# --- Anthropic (claude-* models) --------------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI public API (gpt-*/o* models) ------------------------------------
# Leave blank if you use Azure OpenAI instead (see below).
OPENAI_API_KEY=

# --- Azure OpenAI (gpt-*/o* models from an Azure deployment) ----------------
# Setting AZURE_OPENAI_ENDPOINT is what routes gpt-*/o* calls to Azure instead
# of the public OpenAI API. When using Azure, pass the exact deployment name as
# --model, e.g.:  python -m dvg.generate "..." --model my-gpt-deployment-name
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=
